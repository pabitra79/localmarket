    <!-- My Products Section -->
<section class="products-section py-4">
  <div class="container">
    <h3 class="mb-4">
      <i class="fas fa-box-open text-primary"></i> My Products
    </h3>
    <div class="row g-4">
      <% if (products && products.length > 0) { %>
        <% products.forEach(product => { %>
          <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="card product-card h-100 shadow-sm">
              <div class="product-image-wrapper">
                <img src="/<%= product.image %>" class="card-img-top" alt="<%= product.title %>">
              </div>
              <div class="card-body d-flex flex-column">
                <h5 class="card-title text-truncate"><%= product.title %></h5>
                <p class="card-text text-muted small mb-2">
                  <%= product.description.length > 60 ? product.description.substring(0,60)+'...' : product.description %>
                </p>
                <div class="mt-auto">
                  <p class="fw-bold text-success mb-1">₹ <%= product.price %></p>
                  <span class="badge bg-info text-capitalize"><%= product.category %></span>
                </div>
              </div>
              <div class="card-footer bg-light d-flex justify-content-between">
                <a href="/products/update/<%= product._id %>" class="btn btn-sm btn-outline-warning">
                  <i class="fas fa-edit"></i>
                </a>
                <a href="/products/delete/<%= product._id %>" class="btn btn-sm btn-outline-danger">
                  <i class="fas fa-trash"></i>
                </a>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p class="text-muted">No products found. Add your first product!</p>
      <% } %>
    </div>
  </div>
</section>


    <!-- Content Section -->
    <section class="content-section">
      <div class="container">
        <div class="row g-4">
          <!-- Profile Summary -->
          <div class="col-lg-4">
            <div class="content-card">
              <h5 class="card-title">
                <i class="fas fa-user-circle text-primary"></i>
                Profile Summary
              </h5>
              <div class="text-center mb-6">
                <div class="profile-avatar"><%= user.name|| user.email %></div>
                <h6 class="mb-2"><%= user.name|| user.email %></h6>
                <p class="mb-0 opacity-75">
                  Welcome back, <%= user.name|| user.email %>!
                </p>
              </br>
                <span class="user-role">User</span>
              </div>

              <div class="mb-4">
                <div class="d-flex justify-content-between mb-2">
                  <small class="text-muted">Profile Completion</small>
                  <small class="text-success fw-bold">85%</small>
                </div>
                <div class="progress">
                  <div class="progress-bar" style="width: 85%"></div>
                </div>
              </div>

              <div class="d-grid">
                <button class="btn btn-outline-primary">
                  <i class="fas fa-edit me-2"></i>Edit Profile
                </button>
              </div>
            </div>
          </div>

          <!-- Recent Activity -->
          <div class="col-lg-8">
            <div class="content-card">
              <div
                class="d-flex justify-content-between align-items-center mb-4"
              >
                <h5 class="card-title mb-0">
                  <i class="fas fa-history text-primary"></i>
                  Recent Activity
                </h5>
                <button class="view-all-btn">View All</button>
              </div>

              <div class="activity-timeline">
                <div class="activity-item d-flex align-items-center">
                  <div
                    class="activity-icon me-3"
                    style="background: var(--success-color); color: white"
                  >
                    <i class="fas fa-sign-in-alt"></i>
                  </div>
                  <div class="flex-grow-1">
                    <h6 class="mb-1">Logged in successfully</h6>
                    <small class="text-muted">Today at 9:30 AM</small>
                  </div>
                </div>

                <div class="activity-item d-flex align-items-center">
                  <div
                    class="activity-icon me-3"
                    style="background: var(--primary-color); color: white"
                  >
                    <i class="fas fa-edit"></i>
                  </div>
                  <div class="flex-grow-1">
                    <h6 class="mb-1">Profile updated</h6>
                    <small class="text-muted">Yesterday at 2:15 PM</small>
                  </div>
                </div>

                <div class="activity-item d-flex align-items-center">
                  <div
                    class="activity-icon me-3"
                    style="background: var(--success-color); color: white"
                  >
                    <i class="fas fa-check-circle"></i>
                  </div>
                  <div class="flex-grow-1">
                    <h6 class="mb-1">Task completed</h6>
                    <small class="text-muted">2 days ago at 4:45 PM</small>
                  </div>
                </div>

                <div class="activity-item d-flex align-items-center">
                  <div
                    class="activity-icon me-3"
                    style="background: var(--accent-color); color: white"
                  >
                    <i class="fas fa-plus"></i>
                  </div>
                  <div class="flex-grow-1">
                    <h6 class="mb-1">Account created</h6>
                    <small class="text-muted">1 week ago</small>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Quick Actions -->
          <div class="col-12">
            <div class="content-card">
              <h5 class="card-title">
                <i class="fas fa-bolt text-primary"></i>
                Quick Actions
              </h5>

              <div class="row g-3">
                <div class="col-lg-3 col-md-6">
                  <a href="#" class="quick-action-btn">
                    <i class="fas fa-key text-warning"></i>
                    <div class="fw-bold">Change Password</div>
                  </a>
                </div>
                <div class="col-lg-3 col-md-6">
                  <a href="#" class="quick-action-btn">
                    <i class="fas fa-download text-success"></i>
                    <div class="fw-bold">Export Data</div>
                  </a>
                </div>
                <div class="col-lg-3 col-md-6">
                  <a href="#" class="quick-action-btn">
                    <i class="fas fa-cog text-info"></i>
                    <div class="fw-bold">Settings</div>
                  </a>
                </div>
                <div class="col-lg-3 col-md-6">
                  <a href="#" class="quick-action-btn">
                    <i class="fas fa-question-circle text-primary"></i>
                    <div class="fw-bold">Help & Support</div>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
     <%- include('layouts/footer') %>
  </body>
</html>
