<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>User Dashboard</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
    />
    <link href="/css/style.css" rel="stylesheet" />
  </head>
  <body>
    <!-- Dashboard Header -->
   <section class="dashboard-header py-4 px-2">
  <div class="container">
    <div class="row align-items-center">
      
      <!-- Left side -->
      <div class="col-md-6">
        <h1 class="mb-1">
          <i class="fas fa-tachometer-alt me-2"></i>User Dashboard
        </h1>
        <p class="mb-0 opacity-75">
          Welcome back, <%= user.name || user.email %>!
        </p>
      </div>

      <!-- Right side -->
      <div class="col-md-6 text-md-end mt-3 mt-md-0">
        <span class="badge bg-success fs-6 me-3">
          <i class="fas fa-circle me-1" style="font-size: 0.5em"></i> Online
        </span>
        <span class="text-white-50 me-3">
          Last login: <%= new Date().toLocaleDateString() %>
        </span>

        <!-- Nav Buttons -->
        <span class="nav-buttons">
          <a href="/product/add" class="btn btn-primary">
            <i class="fas fa-plus"></i> Add Product
          </a>
          <a href="/products" class="btn btn-secondary">
            <i class="fas fa-list"></i> My Products
          </a>
        </span>

        <!-- Logout -->
        <a href="/logout" class="logout-btn">
          <i class="fas fa-sign-out-alt"></i> Logout
        </a>
      </div>


    </div>
  </div>
</section>

