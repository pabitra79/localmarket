<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= product.title %> - Product Details</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <link href="/css/productDetails.css" rel="stylesheet" />
  </head>
  <body class="bg-light">
    <!-- Back Button -->
    <div class="back-btn">
      <a href="/" class="btn btn-outline-primary">
        <i class="fas fa-arrow-left me-2"></i>Back to Products
      </a>
    </div>

    <div class="container mt-5 pt-4">
      <div class="row">
        <!-- Product Image -->
        <div class="col-lg-6 mb-4">
          <img
            src="/<%= product.image %>"
            class="img-fluid product-image w-100"
            alt="<%= product.title %>"
          />
        </div>

        <!-- Product Details -->
        <div class="col-lg-6">
          <div class="product-info">
            <h1 class="display-5 fw-bold text-dark mb-3">
              <%= product.title %>
            </h1>

            <div class="price-display mb-3">₹<%= product.price %></div>

            <span class="badge product-badge text-white px-3 py-2 mb-4">
              <i class="fas fa-tag me-2"></i><%= product.category %>
            </span>

            <div class="product-description mb-4">
              <h5 class="text-muted mb-3">Description</h5>
              <p class="lead text-secondary"><%= product.description %></p>
            </div>

            <!-- Action Buttons -->
            <div class="d-grid gap-2 d-md-flex justify-content-md-start mb-4">
              <button class="btn btn-success btn-lg me-md-2" type="button">
                <i class="fas fa-shopping-cart me-2"></i>Add to Cart
              </button>
              <button class="btn btn-outline-primary btn-lg" type="button">
                <i class="fas fa-heart me-2"></i>Add to Wishlist
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Seller Information Card -->
      <div class="row mt-5">
        <div class="col-12">
          <div class="seller-card p-4 shadow">
            <h4 class="mb-3">
              <i class="fas fa-store me-2"></i>Seller Information
            </h4>
            <div class="row">
              <div class="col-md-4 mb-3">
                <div class="d-flex align-items-center">
                  <i class="fas fa-user me-3 fa-lg"></i>
                  <div>
                    <h6 class="mb-0">Seller Name</h6>
                    <p class="mb-0"><%= product.sellerDetails.name %></p>
                  </div>
                </div>
              </div>
              <div class="col-md-4 mb-3">
                <div class="d-flex align-items-center">
                  <i class="fas fa-envelope me-3 fa-lg"></i>
                  <div>
                    <h6 class="mb-0">Email</h6>
                    <p class="mb-0"><%= product.sellerDetails.email %></p>
                  </div>
                </div>
              </div>
              <div class="col-md-4 mb-3">
                <div class="d-flex align-items-center">
                  <i class="fas fa-phone me-3 fa-lg"></i>
                  <div>
                    <h6 class="mb-0">Phone</h6>
                    <p class="mb-0"><%= product.sellerDetails.phone %></p>
                  </div>
                </div>
              </div>
            </div>
            <div class="mt-3">
              <button class="btn btn-light btn-sm me-2">
                <i class="fas fa-envelope me-2"></i>Contact Seller
              </button>
              <button class="btn btn-outline-light btn-sm">
                <i class="fas fa-flag me-2"></i>Report Product
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Additional Product Info -->
      <div class="row mt-4 mb-5">
        <div class="col-12">
          <div class="card">
            <div class="card-header bg-primary text-white">
              <h5 class="mb-0">
                <i class="fas fa-info-circle me-2"></i>Product Information
              </h5>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-md-6">
                  <p><strong>Product ID:</strong> <%= product._id %></p>
                  <p><strong>Category:</strong> <%= product.category %></p>
                </div>
                <div class="col-md-6">
                  <p>
                    <strong>Listed Date:</strong> <%= new
                    Date(product.createdAt).toLocaleDateString() %>
                  </p>
                  <p>
                    <strong>Availability:</strong>
                    <span class="badge bg-success">In Stock</span>
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
