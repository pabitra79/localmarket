<!DOCTYPE html>
<html>
  <head>
    <title>Add Product - SecureAuth</title>
    <link rel="stylesheet" href="/css/addproduct.css" />
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h2>Add Product for Sale</h2>
        <p>Fill out the details below to list your product</p>
      </div>

      <div class="form-container">
        <!-- Success/Error Messages -->
        <% if (locals.success && locals.message) { %>
        <div class="success-message"><%= message %></div>
        <% } %> <% if (locals.success === false && locals.message) { %>
        <div class="error-message"><%= message %></div>
        <% } %>

        <form
          action="/products/create"
          method="POST"
          enctype="multipart/form-data"
          id="productForm"
        >
          <div class="form-row">
            <div class="form-group">
              <label>Product Title</label>
              <input
                type="text"
                name="title"
                placeholder="Enter product title"
                required
              />
            </div>

            <div class="form-group">
              <label>Price (₹)</label>
              <input
                type="number"
                name="price"
                min="0"
                step="0.01"
                placeholder="0.00"
                required
              />
            </div>
          </div>

          <div class="form-group">
            <label>Description</label>
            <textarea
              name="description"
              placeholder="Describe your product in detail..."
              required
            ></textarea>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Category</label>
              <select name="category" required>
                <option value="">Select category</option>
                <option value="electronics">Electronics</option>
                <option value="furniture">Furniture</option>
                <option value="clothing">Clothing</option>
                <option value="books">Books</option>
                <option value="general">General</option>
              </select>
            </div>

            <div class="form-group">
              <label>Product Image</label>
              <div class="file-input-wrapper">
                <input
                  type="file"
                  name="image"
                  accept="image/*"
                  id="imageInput"
                />
                <label for="imageInput" class="file-input-label">
                  <i>📸</i>
                  <span id="fileText">Click to upload image</span>
                </label>
              </div>
            </div>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn-primary" id="submitBtn">
              Add Product
            </button>
            <a href="/userdashboard" class="btn-cancel">Cancel</a>
          </div>
        </form>
      </div>
    </div>
    <script src="./js/addproduct.js"></script>
  </body>
</html>
